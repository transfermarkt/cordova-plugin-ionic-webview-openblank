<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0" id="cordova-plugin-ionic-webview-openblank" version="1.2.0">
    <name>OpenBlank</name>
    <description>Cordova WKWebView OpenBlank Plugin</description>
    <license>Apache 2.0</license>
    <keywords>cordova, wkwebview, ionic, webview, iframe, openblank</keywords>
    <platform name="ios">
      <config-file target="config.xml" parent="/*">
        <feature name="TMOpenBlankNavigationGuard">
            <param name="ios-package" value="TMOpenBlankNavigationGuard" />
            <param name="onload" value="true" />
        </feature>
      </config-file>
      <header-file src="src/ios/CDVWKWebViewUIDelegate+OpenBlank.h" />
      <source-file src="src/ios/CDVWKWebViewUIDelegate+OpenBlank.m" />
    </platform>
    <dependency id="cordova-plugin-ionic-webview" version="^5.0.0" />
</plugin>
